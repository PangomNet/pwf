{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pangom.dev/pwf/schemas/addon.schema.json",
  "title": "PWF add-on manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "pwfVersion", "license", "entry", "styles", "routes", "settings", "dependencies", "capabilities", "removable"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "pwfVersion": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "entry": { "type": "string", "pattern": "^[a-zA-Z0-9._/-]+\\.js$" },
    "styles": { "type": "array", "items": { "type": "string", "pattern": "^[a-zA-Z0-9._/-]+\\.css$" } },
    "routes": { "type": "array", "items": { "type": "string" } },
    "settings": { "type": "array", "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9.-]*$" } },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
    "removable": { "const": true }
  },
  "additionalProperties": false
}
