{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pangom.dev/pwf/schemas/license-inventory.schema.json",
  "title": "PWF license inventory",
  "type": "object",
  "required": ["schemaVersion", "projectLicense", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectLicense": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "version", "license", "distribution", "notice"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "distribution": { "type": "string", "minLength": 1 },
          "homepage": { "type": "string", "format": "uri" },
          "notice": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
