{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pangom.dev/pwf/schemas/theme.schema.json",
  "title": "PWF theme manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "pwfVersion", "license", "styles", "modes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "pwfVersion": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "styles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-zA-Z0-9._/-]+\\.css$" }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["light", "dark"] }
    }
  },
  "additionalProperties": false
}
