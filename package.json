{
  "name": "@pangom/pwf",
  "version": "0.1.0-alpha.1",
  "description": "Modular, accessible web application framework with optional Tailwind CSS integration",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "docs",
    "examples",
    "schemas",
    "catalog",
    "tailwind.preset.cjs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": "./dist/pwf.js",
    "./styles": "./dist/pwf.css",
    "./themes/*": "./dist/themes/*",
    "./tailwind-preset": "./tailwind.preset.cjs",
    "./schemas/*": "./dist/schemas/*"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test",
    "check": "node scripts/build.mjs && node --test"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.4.0 <5"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
